function renderObject(id) {
  const o = OBJECTS.find(x => x.id === id);
  if (!o) return;
  currentObject = o;
  const d = getDevelopment(o.developmentId);

  document.getElementById("obj-back").onclick = () => go("development", o.developmentId);
  document.getElementById("obj-type").textContent = o.type + (d ? " · " + d.title : "");
  document.getElementById("obj-title").textContent = o.title;
  document.getElementById("obj-loc").textContent = d ? d.city + (d.location ? " · " + d.location : "") : "";
  document.getElementById("obj-price").textContent = formatRub(o.price);
  document.getElementById("obj-desc").textContent = o.description;

  const soldBanner = document.getElementById("obj-sold-banner");
  soldBanner.style.display = o.status === "sold" ? "block" : "none";

  document.getElementById("obj-specs").innerHTML = `
    <div class="spec"><div class="spec-label">Площадь</div><div class="spec-value">${o.area}</div></div>
    <div class="spec"><div class="spec-label">Комнат</div><div class="spec-value">${o.rooms}</div></div>
    <div class="spec"><div class="spec-label">Этаж</div><div class="spec-value">${o.floor}${o.totalFloors ? " из " + o.totalFloors : ""}</div></div>
    <div class="spec"><div class="spec-label">ЖК</div><div class="spec-value">${d ? d.title : "—"}</div></div>
  `;

  document.getElementById("gallery-track").innerHTML = o.images.map(c =>
    `<div class="gallery-slide" style="background:${c};"></div>`
  ).join("");
  document.getElementById("gallery-dots").innerHTML = o.images.map((_, i) =>
    `<div class="dot ${i === 0 ? 'on' : ''}"></div>`
  ).join("");
  setupGalleryDots();

  const waText = `Здравствуйте! Интересует квартира «${o.title}»${d ? ", ЖК " + d.title : ""}, ${o.area}, ${o.floor} этаж, цена ${formatRub(o.price)}. Хотел бы узнать подробнее.`;
  document.getElementById("wa-link").href = `https://wa.me/${REALTOR_PHONE}?text=${encodeURIComponent(waText)}`;
  document.getElementById("viewer-wa").href = `https://wa.me/${REALTOR_PHONE}?text=${encodeURIComponent(waText + " Хочу уточнить планировку.")}`;
  renderPersonalBlock("obj-personal", waText);

  hideInfo();
  viewerInited = false;
  document.getElementById("viewer-loading").style.display = "flex";
  document.getElementById("viewer-loading").textContent = "Загрузка модели…";
  document.getElementById("viewer-reset").style.display = "none";
  initViewer(o.modelUrl);
}

function setupGalleryDots() {
  const track = document.getElementById("gallery-track");
  const dots = document.querySelectorAll("#gallery-dots .dot");
  track.onscroll = () => {
    const idx = Math.round(track.scrollLeft / track.clientWidth);
    dots.forEach((d, i) => d.classList.toggle("on", i === idx));
  };
}

