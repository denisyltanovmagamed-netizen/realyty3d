<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>REALTY — Мухаммад</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#14181A;
    --bg-raised:#1B2023;
    --line:#2A3033;
    --ink:#ECE8E0;
    --ink-dim:#9BA3A3;
    --gold:#B9924F;
    --gold-dim:#8A6E3D;
    --wa:#3FA772;
    --radius:14px;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *{box-sizing:inherit;margin:0;padding:0;}
  html{scroll-padding-top:env(safe-area-inset-top,0px);}
  html,body{height:100%;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Manrope',sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3,.display{font-family:'Fraunces',serif;font-weight:500;letter-spacing:-0.01em;}
  a{color:inherit;text-decoration:none;}
  button{font:inherit;color:inherit;background:none;border:none;cursor:pointer;}
  img,svg{display:block;max-width:100%;}

  .view{display:none;min-height:100%;}
  .view.active{display:block;}

  /* ---------- Top bar ---------- */
  .topbar{
    position:sticky;top:0;z-index:20;
    padding-top:calc(14px + env(safe-area-inset-top,0px));
    padding:calc(14px + env(safe-area-inset-top,0px)) 20px 14px;
    display:flex;align-items:center;gap:12px;
    background:linear-gradient(var(--bg) 70%, transparent);
  }
  .backbtn{
    width:36px;height:36px;border-radius:50%;
    background:var(--bg-raised);border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .backbtn svg{width:16px;height:16px;}
  .topbar-title{font-size:15px;color:var(--ink-dim);letter-spacing:0.02em;}

  /* ---------- Home / profile hero ---------- */
  .hero{
    position:relative;
    min-height:82vh;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;
    padding:calc(28px + env(safe-area-inset-top,0px)) 24px calc(40px + env(safe-area-inset-bottom,0px));
    background:
      radial-gradient(120% 70% at 50% 0%, #26302B 0%, transparent 60%),
      linear-gradient(180deg, #171B1D 0%, #101314 100%);
  }
  .hero-mark{
    position:absolute;top:calc(20px + env(safe-area-inset-top,0px));left:24px;
    font-size:12.5px;letter-spacing:0.16em;color:var(--gold);
  }
  .hero-avatar{
    width:104px;height:104px;border-radius:50%;
    overflow:hidden;border:2px solid var(--gold);
    background:var(--bg-raised);
    display:flex;align-items:center;justify-content:center;
  }
  .hero-avatar img{width:100%;height:100%;object-fit:cover;}
  .hero-avatar-fallback{
    width:100%;height:100%;display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif;font-size:32px;color:var(--gold);
  }
  .hero-name{font-size:24px;margin-top:18px;}
  .hero-title{font-size:14px;color:var(--ink-dim);margin-top:6px;letter-spacing:0.01em;}
  .hero-geo{font-size:13px;color:var(--gold);margin-top:10px;letter-spacing:0.02em;}
  .hero-geo .dot{color:var(--ink-dim);margin:0 2px;}
  .hero-tags{
    display:flex;flex-wrap:wrap;justify-content:center;gap:8px;
    margin-top:18px;max-width:280px;
  }
  .hero-tags span{
    font-size:12px;color:var(--ink-dim);
    border:1px solid var(--line);border-radius:999px;padding:6px 12px;
  }
  .hero-actions{
    display:flex;flex-direction:column;gap:10px;margin-top:28px;width:100%;max-width:300px;
  }
  .hero .cta{
    display:flex;align-items:center;justify-content:center;gap:8px;
    background:var(--gold);color:#1A1A1A;
    padding:14px 22px;border-radius:999px;
    font-weight:600;font-size:15px;
  }
  .hero .cta-ghost{
    background:transparent;color:var(--wa);border:1px solid var(--wa);
  }

  /* ---------- Catalog ---------- */
  .catalog-head{padding:8px 24px 4px;}
  .catalog-head h2{font-size:26px;}
  .catalog-head p{color:var(--ink-dim);font-size:14px;margin-top:6px;}
  .catalog-list{padding:18px 20px 60px;display:flex;flex-direction:column;gap:16px;}

  .card{
    background:var(--bg-raised);
    border:1px solid var(--line);
    border-radius:var(--radius);
    overflow:hidden;
    display:flex;flex-direction:column;
    position:relative;
  }
  .card-img{
    aspect-ratio:4/3;width:100%;
    background:#20262A;object-fit:cover;
  }
  .card-body{padding:16px 18px 18px;}
  .card-type{font-size:12px;color:var(--gold);letter-spacing:0.03em;}
  .card-title{font-size:19px;margin-top:5px;}
  .card-meta{display:flex;gap:14px;color:var(--ink-dim);font-size:13px;margin-top:8px;}
  .card-price{margin-top:12px;font-size:17px;font-family:'Fraunces',serif;}
  .sold-badge{
    position:absolute;top:10px;right:10px;z-index:2;
    background:rgba(20,24,26,0.85);color:var(--ink-dim);
    border:1px solid var(--line);border-radius:999px;
    font-size:11.5px;padding:5px 11px;letter-spacing:0.02em;
  }

  /* ---------- ЖК (development) page ---------- */
  .dev-cover{width:100%;aspect-ratio:16/10;background:#20262A;object-fit:cover;}
  .dev-body{padding:20px 22px 4px;}
  .dev-title{font-size:24px;}
  .dev-city{color:var(--ink-dim);font-size:14px;margin-top:6px;}
  .dev-facts{
    display:grid;grid-template-columns:1fr 1fr;gap:1px;
    background:var(--line);border:1px solid var(--line);border-radius:var(--radius);
    margin:18px 22px 0;overflow:hidden;
  }
  .dev-fact{background:var(--bg-raised);padding:13px 16px;}
  .dev-fact-label{font-size:11.5px;color:var(--ink-dim);}
  .dev-fact-value{font-size:15px;margin-top:3px;}
  .dev-objects-list{padding:14px 20px 8px;display:flex;flex-direction:column;gap:14px;}

  /* ---------- Personal block ---------- */
  .personal-block{
    margin:18px 22px 0;padding:14px 16px;
    background:var(--bg-raised);border:1px solid var(--line);border-radius:var(--radius);
    display:flex;align-items:center;gap:12px;
  }
  .personal-block .pb-avatar{
    width:42px;height:42px;border-radius:50%;flex-shrink:0;
    overflow:hidden;background:var(--bg);border:1px solid var(--gold-dim);
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif;color:var(--gold);font-size:14px;
  }
  .personal-block .pb-avatar img{width:100%;height:100%;object-fit:cover;}
  .personal-block .pb-avatar-fallback{display:flex;align-items:center;justify-content:center;width:100%;height:100%;}
  .personal-block .pb-info{flex:1;min-width:0;}
  .personal-block .pb-name{font-size:14px;font-weight:600;}
  .personal-block .pb-title{font-size:12px;color:var(--ink-dim);margin-top:2px;}
  .personal-block .pb-wa{
    flex-shrink:0;width:38px;height:38px;border-radius:50%;
    background:var(--wa);color:#0C1A13;display:flex;align-items:center;justify-content:center;
  }
  .personal-block .pb-wa svg{width:18px;height:18px;}

  /* ---------- Object page ---------- */
  .gallery{position:relative;background:#0F1213;}
  .gallery-track{
    display:flex;overflow-x:auto;scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
  }
  .gallery-track::-webkit-scrollbar{display:none;}
  .gallery-slide{
    flex:0 0 100%;scroll-snap-align:start;
    aspect-ratio:4/3;
  }
  .gallery-dots{
    position:absolute;bottom:12px;left:0;right:0;
    display:flex;justify-content:center;gap:6px;
  }
  .dot{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,0.35);}
  .dot.on{background:var(--gold);}

  .obj-body{padding:22px 22px 12px;}
  .obj-type{font-size:12.5px;color:var(--gold);letter-spacing:0.03em;}
  .obj-title{font-size:26px;margin-top:6px;}
  .obj-loc{color:var(--ink-dim);font-size:14px;margin-top:6px;}
  .obj-price{font-size:22px;font-family:'Fraunces',serif;margin-top:16px;}
  .obj-sold-banner{
    margin:16px 22px 0;padding:12px 14px;border-radius:10px;
    background:rgba(185,146,79,0.12);border:1px solid var(--gold-dim);
    color:var(--gold);font-size:13.5px;font-weight:600;text-align:center;
  }

  .specs{
    display:grid;grid-template-columns:1fr 1fr;gap:1px;
    background:var(--line);border:1px solid var(--line);border-radius:var(--radius);
    margin:20px 22px 0;overflow:hidden;
  }
  .spec{background:var(--bg-raised);padding:14px 16px;}
  .spec-label{font-size:12px;color:var(--ink-dim);}
  .spec-value{font-size:16px;margin-top:3px;}

  .section-label{
    padding:28px 22px 12px;font-size:13px;color:var(--ink-dim);letter-spacing:0.03em;
  }
  .obj-desc{padding:0 22px;color:#CFCBC3;font-size:14.5px;line-height:1.65;}

  /* ---------- 3D viewer ---------- */
  .viewer-wrap{margin:14px 22px 0;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);}
  .viewer-canvas-holder{
    position:relative;width:100%;aspect-ratio:4/3;background:#0E1112;
    touch-action:none;
  }
  .viewer-canvas-holder canvas{width:100%!important;height:100%!important;display:block;}
  .viewer-hint{
    position:absolute;bottom:10px;left:10px;right:10px;
    font-size:11.5px;color:rgba(255,255,255,0.55);
    display:flex;justify-content:space-between;pointer-events:none;
  }
  .viewer-loading{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    color:var(--ink-dim);font-size:13px;
  }
  .viewer-reset{
    position:absolute;top:10px;right:10px;
    background:rgba(20,24,26,0.7);border:1px solid var(--line);
    border-radius:999px;padding:7px 13px;font-size:12px;color:var(--ink);
  }
  .room-nav{
    display:flex;gap:8px;overflow-x:auto;
    padding:12px 12px 10px;
    -webkit-overflow-scrolling:touch;
  }
  .room-nav::-webkit-scrollbar{display:none;}
  .room-pill{
    flex:0 0 auto;
    padding:8px 14px;border-radius:999px;
    background:var(--bg);border:1px solid var(--line);
    font-size:12.5px;color:var(--ink-dim);white-space:nowrap;
  }
  .room-pill.active{background:var(--gold);border-color:var(--gold);color:#1A1A1A;font-weight:600;}
  .viewer-info{padding:12px 14px 4px;min-height:52px;}
  .viewer-info-empty{font-size:12.5px;color:var(--ink-dim);}
  .viewer-info-card{
    background:var(--bg);border:1px solid var(--line);border-radius:10px;
    padding:12px 14px;
  }
  .viewer-info-title{font-size:14.5px;font-weight:600;color:var(--gold);}
  .viewer-info-text{font-size:13px;color:#CFCBC3;margin-top:4px;line-height:1.5;}
  .viewer-wa{
    margin:6px 14px 16px;
    display:flex;align-items:center;justify-content:center;gap:8px;
    border:1px solid var(--gold-dim);color:var(--gold);
    border-radius:999px;padding:12px;font-size:13.5px;font-weight:600;
  }
  .walk-toggle{
    position:absolute;top:10px;left:10px;
    background:rgba(20,24,26,0.7);border:1px solid var(--line);
    border-radius:999px;padding:7px 13px;font-size:12px;color:var(--ink);
    display:flex;align-items:center;gap:6px;z-index:5;
  }
  .walk-toggle.on{background:var(--gold);color:#1A1A1A;border-color:var(--gold);}
  .joystick{
    position:absolute;left:16px;bottom:16px;width:88px;height:88px;
    border-radius:50%;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);
    display:none;touch-action:none;
  }
  .joystick.show{display:block;}
  .joystick-nub{
    position:absolute;left:50%;top:50%;width:38px;height:38px;margin:-19px 0 0 -19px;
    border-radius:50%;background:rgba(255,255,255,0.35);
  }
  .walk-hint{
    position:absolute;right:10px;bottom:16px;
    font-size:11px;color:rgba(255,255,255,0.6);
    background:rgba(20,24,26,0.6);padding:6px 10px;border-radius:8px;
    display:none;
  }
  .walk-hint.show{display:block;}

  /* ---------- WhatsApp bar ---------- */
  .wa-spacer{height:96px;}
  .wa-bar{
    position:fixed;left:0;right:0;bottom:0;z-index:30;
    padding:14px 20px calc(16px + env(safe-area-inset-bottom,0px));
    background:linear-gradient(0deg, var(--bg) 55%, transparent);
  }
  .wa-btn{
    display:flex;align-items:center;justify-content:center;gap:10px;
    background:var(--wa);color:#0C1A13;
    padding:15px;border-radius:999px;font-weight:700;font-size:15.5px;
    box-shadow:0 8px 24px rgba(63,167,114,0.28);
  }
  .wa-btn svg{width:18px;height:18px;}

  .empty-note{padding:40px 24px;color:var(--ink-dim);font-size:14px;}
</style>
</head>
<body>

<!-- ================= HOME ================= -->
<section id="view-home" class="view active">
  <div class="hero">
    <div class="hero-mark">REALTY</div>
    <div class="hero-avatar">
      <img src="assets/images/profile.jpg" alt="Мухаммад Денисултанов" onerror="this.onerror=null; this.src=PROFILE_PHOTO_FALLBACK;">
      <div class="hero-avatar-fallback" style="display:none;">МД</div>
    </div>
    <h1 class="hero-name">Мухаммад Денисултанов</h1>
    <div class="hero-title">Риелтор · Недвижимость</div>
    <div class="hero-geo">Грозный <span class="dot">•</span> Dubai</div>
    <div class="hero-tags">
      <span>Квартиры</span><span>Дома</span><span>Коммерция</span><span>Участки</span>
    </div>
    <div class="hero-actions">
      <button class="cta" onclick="go('catalog')">Смотреть объекты</button>
      <a class="cta cta-ghost" id="hero-wa" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.16c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.18-4.94-4.37-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.26-.29.58-.36.77-.36h.55c.18 0 .42-.07.66.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.14.31-.28.48-.14.17-.29.37-.41.5-.14.14-.28.29-.12.57.16.29.71 1.18 1.53 1.91 1.05.94 1.94 1.24 2.22 1.38.28.14.44.12.6-.07.16-.19.68-.79.87-1.06.19-.27.37-.22.62-.13.26.1 1.63.77 1.91.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>
        Связаться со мной
      </a>
    </div>
  </div>
</section>

<!-- ================= CATALOG (ЖК) ================= -->
<section id="view-catalog" class="view">
  <div class="topbar">
    <button class="backbtn" onclick="go('home')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="topbar-title">Грозный</div>
  </div>
  <div class="catalog-head">
    <h2>Жилые комплексы</h2>
    <p>Выберите ЖК, чтобы посмотреть квартиры</p>
  </div>
  <div class="catalog-list" id="dev-list"></div>
</section>

<!-- ================= DEVELOPMENT (ЖК) ================= -->
<section id="view-development" class="view">
  <div class="topbar">
    <button class="backbtn" onclick="go('catalog')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="topbar-title" id="dev-topbar-title"></div>
  </div>
  <img class="dev-cover" id="dev-cover" alt="">
  <div class="dev-body">
    <div class="dev-title" id="dev-title"></div>
    <div class="dev-city" id="dev-city"></div>
  </div>
  <div class="dev-facts" id="dev-facts"></div>
  <div class="personal-block" id="dev-personal"></div>
  <div class="section-label">Квартиры в продаже</div>
  <div class="dev-objects-list" id="dev-objects-list"></div>
</section>

<!-- ================= OBJECT ================= -->
<section id="view-object" class="view">
  <div class="topbar" style="background:linear-gradient(rgba(20,24,26,0.75) 60%, transparent);position:absolute;width:100%;">
    <button class="backbtn" id="obj-back" onclick="go('catalog')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
  </div>

  <div class="gallery">
    <div class="gallery-track" id="gallery-track"></div>
    <div class="gallery-dots" id="gallery-dots"></div>
  </div>

  <div class="obj-body">
    <div class="obj-type" id="obj-type"></div>
    <h1 class="obj-title" id="obj-title"></h1>
    <div class="obj-loc" id="obj-loc"></div>
    <div class="obj-price" id="obj-price"></div>
  </div>

  <div class="obj-sold-banner" id="obj-sold-banner" style="display:none;">Этот объект продан</div>

  <div class="specs" id="obj-specs"></div>
  <div class="personal-block" id="obj-personal"></div>

  <div class="section-label">3D‑модель</div>
  <div class="viewer-wrap">
    <div class="room-nav" id="room-nav"></div>
    <div class="viewer-canvas-holder" id="viewer-holder">
      <div class="viewer-loading" id="viewer-loading">Загрузка модели…</div>
      <button class="viewer-reset" id="viewer-reset" style="display:none;">Сбросить вид</button>
      <button class="walk-toggle" id="walk-toggle" style="display:none;">🚶 Прогулка</button>
      <div class="joystick" id="joystick"><div class="joystick-nub" id="joystick-nub"></div></div>
      <div class="walk-hint" id="walk-hint">Джойстик — шаг, свайп по экрану — осмотреться</div>
    </div>
    <div class="viewer-info" id="viewer-info">
      <div class="viewer-info-empty" id="viewer-info-empty">Нажмите на комнату или предмет, чтобы узнать больше</div>
      <div class="viewer-info-card" id="viewer-info-card" style="display:none;">
        <div class="viewer-info-title" id="viewer-info-title"></div>
        <div class="viewer-info-text" id="viewer-info-text"></div>
      </div>
    </div>
    <div style="padding:2px 14px 12px;font-size:11.5px;color:var(--ink-dim);display:flex;justify-content:space-between;">
      <span>Один палец — вращение</span><span>Два пальца — зум/сдвиг</span>
    </div>
    <a class="viewer-wa" id="viewer-wa" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.16c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.18-4.94-4.37-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.26-.29.58-.36.77-.36h.55c.18 0 .42-.07.66.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.14.31-.28.48-.14.17-.29.37-.41.5-.14.14-.28.29-.12.57.16.29.71 1.18 1.53 1.91 1.05.94 1.94 1.24 2.22 1.38.28.14.44.12.6-.07.16-.19.68-.79.87-1.06.19-.27.37-.22.62-.13.26.1 1.63.77 1.91.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>
      Спросить риелтора про эту планировку
    </a>
  </div>

  <div class="section-label">Об объекте</div>
  <p class="obj-desc" id="obj-desc"></p>

  <div class="wa-spacer"></div>
</section>

