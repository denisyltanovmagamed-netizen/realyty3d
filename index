/* ---- переключение видов ---- */
function renderRoomNav() {
  const nav = document.getElementById("room-nav");
  const keys = ["overview", ...Object.keys(ROOMS)];
  nav.innerHTML = keys.map(k =>
    `<button class="room-pill ${k === activeRoomKey ? "active" : ""}" data-room="${k}">${k === "overview" ? "Общий вид" : ROOMS[k].name}</button>`
  ).join("");
  nav.querySelectorAll(".room-pill").forEach(btn => {
    btn.onclick = () => goToRoom(btn.dataset.room);
  });
}

function goToRoom(key) {
  if (walkMode) exitWalkMode();
  activeRoomKey = key;
  document.querySelectorAll(".room-pill").forEach(b => b.classList.toggle("active", b.dataset.room === key));
  if (!camera || !controls) return;
  if (key === "overview" && overviewPreset) {
    camera.position.set(...overviewPreset.pos);
    controls.target.set(...overviewPreset.target);
    controls.minDistance = overviewPreset.minDistance;
    controls.maxDistance = overviewPreset.maxDistance;
    hideInfo();
  } else if (ROOMS[key]) {
    const r = ROOMS[key];
    camera.position.set(...r.camPos);
    controls.target.set(...r.camTarget);
    controls.minDistance = 0.5;
    controls.maxDistance = 5;
    showInfo(r.name, r.info + " · " + r.area);
  }
  controls.update();
}

function showInfo(title, text) {
  document.getElementById("viewer-info-empty").style.display = "none";
  const card = document.getElementById("viewer-info-card");
  card.style.display = "block";
  document.getElementById("viewer-info-title").textContent = title;
  document.getElementById("viewer-info-text").textContent = text;
}
function hideInfo() {
  document.getElementById("viewer-info-empty").style.display = "block";
  document.getElementById("viewer-info-card").style.display = "none";
}

function initViewer(modelUrl) {
  const holder = document.getElementById("viewer-holder");
  const oldCanvas = holder.querySelector("canvas");
  if (oldCanvas) oldCanvas.remove();
  if (viewerFrame) cancelAnimationFrame(viewerFrame);

  walkMode = false; joyVec.x = 0; joyVec.y = 0;
  document.getElementById("walk-toggle").style.display = "none";
  document.getElementById("walk-toggle").classList.remove("on");
  document.getElementById("joystick").classList.remove("show");
  document.getElementById("walk-hint").classList.remove("show");

  const width = holder.clientWidth;
  const height = holder.clientHeight;

  scene = new THREE.Scene();
  camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
  raycaster = new THREE.Raycaster();

  renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(width, height);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  holder.insertBefore(renderer.domElement, holder.firstChild);

  scene.add(new THREE.AmbientLight(0xfff4e6, 0.55));
  const dirLight = new THREE.DirectionalLight(0xfff0dc, 0.95);
  dirLight.position.set(3, 6, -2);
  dirLight.castShadow = true;
  dirLight.shadow.mapSize.set(1024, 1024);
  dirLight.shadow.camera.left = -4.5; dirLight.shadow.camera.right = 4.5;
  dirLight.shadow.camera.top = 5.5; dirLight.shadow.camera.bottom = -5.5;
  dirLight.shadow.camera.near = 1; dirLight.shadow.camera.far = 15;
  dirLight.shadow.bias = -0.002;
  scene.add(dirLight);
  const fillLight = new THREE.DirectionalLight(0xB9924F, 0.25);
  fillLight.position.set(-4, 2, -3);
  scene.add(fillLight);

  controls = new THREE.OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.08;
  controls.enablePan = true;
  controls.maxPolarAngle = Math.PI * 0.49; // не даём камере уйти под пол

  function frameOverview(object, skipRecenter) {
    const box3 = new THREE.Box3().setFromObject(object);
    const size = box3.getSize(new THREE.Vector3());
    const center = box3.getCenter(new THREE.Vector3());
    if (!skipRecenter) object.position.sub(center);
    const wc = skipRecenter ? center : new THREE.Vector3(0, 0, 0);

    const maxDim = Math.max(size.x, size.z) || 1;
    const dist = maxDim * 1.05;
    const pos = [wc.x + dist, dist * 0.85, wc.z + dist];
    const target = [wc.x, 0.3, wc.z];
    overviewPreset = { pos, target, minDistance: maxDim * 0.4, maxDistance: maxDim * 2.5 };
    camera.position.set(...pos);
    controls.target.set(...target);
    controls.minDistance = overviewPreset.minDistance;
    controls.maxDistance = overviewPreset.maxDistance;
    controls.update();
  }

  function showLoaded() {
    document.getElementById("viewer-loading").style.display = "none";
    document.getElementById("viewer-reset").style.display = "block";
    document.getElementById("walk-toggle").style.display = "flex";
    viewerInited = true;
  }

  function loadApartment() {
    const group = buildApartment();
    group.traverse(obj => { if (obj.isMesh) { obj.castShadow = true; obj.receiveShadow = true; } });
    scene.add(group);
    frameOverview(group, true);
    activeRoomKey = "overview";
    renderRoomNav();
    hideInfo();
    showLoaded();
  }

  if (modelUrl) {
    const loader = new THREE.GLTFLoader();
    loader.load(
      modelUrl,
      gltf => { scene.add(gltf.scene); frameOverview(gltf.scene); showLoaded(); },
      undefined,
      () => { loadApartment(); } // реальная модель не загрузилась — показываем схематичную планировку
    );
  } else {
    loadApartment();
  }

  document.getElementById("viewer-reset").onclick = () => goToRoom("overview");

  function enterWalkMode() {
    walkMode = true;
    controls.enabled = false;
    walkYaw = 0; // при yaw=0 камера смотрит в -Z, то есть вглубь квартиры от входа
    walkPitch = 0;
    camera.position.set(0.4, 1.6, 4.1); // старт у входной двери (комната 1)
    hideInfo();
    document.getElementById("walk-toggle").classList.add("on");
    document.getElementById("joystick").classList.add("show");
    document.getElementById("walk-hint").classList.add("show");
    document.getElementById("viewer-reset").style.display = "none";
  }
  function exitWalkMode() {
    walkMode = false;
    controls.enabled = true;
    joyVec.x = 0; joyVec.y = 0;
    document.getElementById("joystick-nub").style.transform = "translate(0,0)";
    document.getElementById("walk-toggle").classList.remove("on");
    document.getElementById("joystick").classList.remove("show");
    document.getElementById("walk-hint").classList.remove("show");
    document.getElementById("viewer-reset").style.display = "block";
    goToRoom("overview");
  }
  document.getElementById("walk-toggle").onclick = () => { walkMode ? exitWalkMode() : enterWalkMode(); };

  // ---- виртуальный джойстик (шаг вперёд/назад/в сторону) ----
  const joyEl = document.getElementById("joystick");
  const joyNub = document.getElementById("joystick-nub");
  let joyActive = false, joyId = null, joyCX = 0, joyCY = 0;
  const JOY_R = 34;
  joyEl.addEventListener("pointerdown", e => {
    joyActive = true; joyId = e.pointerId;
    const r = joyEl.getBoundingClientRect(); joyCX = r.left + r.width / 2; joyCY = r.top + r.height / 2;
    e.stopPropagation();
  });
  window.addEventListener("pointermove", e => {
    if (!joyActive || e.pointerId !== joyId) return;
    let dx = e.clientX - joyCX, dy = e.clientY - joyCY;
    const len = Math.hypot(dx, dy) || 1;
    if (len > JOY_R) { dx = dx / len * JOY_R; dy = dy / len * JOY_R; }
    joyNub.style.transform = `translate(${dx}px, ${dy}px)`;
    joyVec.x = dx / JOY_R; joyVec.y = -dy / JOY_R; // y: вверх на джойстике = вперёд
  });
  window.addEventListener("pointerup", e => {
    if (e.pointerId !== joyId) return;
    joyActive = false; joyVec.x = 0; joyVec.y = 0;
    joyNub.style.transform = "translate(0,0)";
  });

  // тап по комнате/мебели: раскрываем инфо-панель; в режиме прогулки свайп = осмотреться
  let downX = 0, downY = 0, lookX = 0, lookY = 0, looking = false;
  renderer.domElement.addEventListener("pointerdown", e => {
    downX = e.clientX; downY = e.clientY;
    if (walkMode) { looking = true; lookX = e.clientX; lookY = e.clientY; }
  });
  renderer.domElement.addEventListener("pointermove", e => {
    if (!walkMode || !looking) return;
    const dx = e.clientX - lookX, dy = e.clientY - lookY;
    lookX = e.clientX; lookY = e.clientY;
    walkYaw -= dx * 0.005;
    walkPitch = Math.max(-1.1, Math.min(1.1, walkPitch - dy * 0.005));
  });
  renderer.domElement.addEventListener("pointerup", e => {
    looking = false;
    if (Math.hypot(e.clientX - downX, e.clientY - downY) > 6) return; // это было вращение/взгляд, не тап
    const rect = renderer.domElement.getBoundingClientRect();
    const ndc = new THREE.Vector2(
      ((e.clientX - rect.left) / rect.width) * 2 - 1,
      -((e.clientY - rect.top) / rect.height) * 2 + 1
    );
    raycaster.setFromCamera(ndc, camera);
    const hits = raycaster.intersectObjects(scene.children, true);
    for (const hit of hits) {
      const spot = findHotspot(hit.object);
      if (spot) {
        showInfo(spot.title, spot.text);
        if (!walkMode) {
          const roomKey = Object.keys(ROOMS).find(k => ROOMS[k].name === spot.title);
          if (roomKey) goToRoom(roomKey);
        }
        return;
      }
    }
  });

  function updateWalk() {
    camera.rotation.order = "YXZ";
    camera.rotation.y = walkYaw;
    camera.rotation.x = walkPitch;
    const speed = 0.045;
    const sin = Math.sin(walkYaw), cos = Math.cos(walkYaw);
    // вперёд = направление взгляда по горизонтали; страфe — перпендикулярно
    const nx = camera.position.x + (-sin * joyVec.y + cos * joyVec.x) * speed;
    const nz = camera.position.z + (-cos * joyVec.y - sin * joyVec.x) * speed;
    camera.position.x = Math.max(WALK_BOUNDS.xMin, Math.min(WALK_BOUNDS.xMax, nx));
    camera.position.z = Math.max(WALK_BOUNDS.zMin, Math.min(WALK_BOUNDS.zMax, nz));
  }

  function animate() {
    viewerFrame = requestAnimationFrame(animate);
    if (walkMode) updateWalk(); else controls.update();
    renderer.render(scene, camera);
  }
  animate();
}

window.addEventListener("resize", () => {
  if (document.getElementById("view-object").classList.contains("active") && renderer) {
    const holder = document.getElementById("viewer-holder");
    camera.aspect = holder.clientWidth / holder.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(holder.clientWidth, holder.clientHeight);
  }
});

/* =========================================================
   ИНИЦИАЛИЗАЦИЯ
   ========================================================= */
handleHash();
</script>
</body>
