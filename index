function wallAlongX(zPos, xa, xb, opts) {
  const g = new THREE.Group();
  if (!opts) { g.add(box((xa + xb) / 2, WALL_H / 2, zPos, xb - xa, WALL_H, WALL_T, MAT.wall)); return g; }
  const { from, to, type } = opts;
  if (from > xa) g.add(box((xa + from) / 2, WALL_H / 2, zPos, from - xa, WALL_H, WALL_T, MAT.wall));
  if (to < xb) g.add(box((to + xb) / 2, WALL_H / 2, zPos, xb - to, WALL_H, WALL_T, MAT.wall));
  if (type === "door") {
    const doorH = 2.05;
    g.add(box((from + to) / 2, doorH + (WALL_H - doorH) / 2, zPos, to - from, WALL_H - doorH, WALL_T, MAT.wall));
    g.add(box((from + to) / 2, doorH / 2, zPos, to - from - 0.06, doorH - 0.04, WALL_T * 0.6, MAT.door));
  } else if (type === "window") {
    const sill = 0.9, lintel = 2.1;
    g.add(box((from + to) / 2, sill / 2, zPos, to - from, sill, WALL_T, MAT.wall));
    g.add(box((from + to) / 2, lintel + (WALL_H - lintel) / 2, zPos, to - from, WALL_H - lintel, WALL_T, MAT.wall));
    g.add(box((from + to) / 2, sill + (lintel - sill) / 2, zPos, to - from - 0.04, lintel - sill, 0.03, MAT.glass));
  }
  return g;
}

// Стена вдоль оси Z (фиксированный X) — тот же принцип, оси поменяны местами.
function wallAlongZ(xPos, za, zb, opts) {
  const g = new THREE.Group();
  if (!opts) { g.add(box(xPos, WALL_H / 2, (za + zb) / 2, WALL_T, WALL_H, zb - za, MAT.wall)); return g; }
  const { from, to, type } = opts;
  if (from > za) g.add(box(xPos, WALL_H / 2, (za + from) / 2, WALL_T, WALL_H, from - za, MAT.wall));
  if (to < zb) g.add(box(xPos, WALL_H / 2, (to + zb) / 2, WALL_T, WALL_H, zb - to, MAT.wall));
  if (type === "door") {
    const doorH = 2.05;
    g.add(box(xPos, doorH + (WALL_H - doorH) / 2, (from + to) / 2, WALL_T, WALL_H - doorH, to - from, MAT.wall));
    g.add(box(xPos, doorH / 2, (from + to) / 2, WALL_T * 0.6, doorH - 0.04, to - from - 0.06, MAT.door));
  } else if (type === "window") {
    const sill = 0.9, lintel = 2.1;
    g.add(box(xPos, sill / 2, (from + to) / 2, WALL_T, sill, to - from, MAT.wall));
    g.add(box(xPos, lintel + (WALL_H - lintel) / 2, (from + to) / 2, WALL_T, WALL_H - lintel, to - from, MAT.wall));
    g.add(box(xPos, sill + (lintel - sill) / 2, (from + to) / 2, 0.03, lintel - sill, to - from - 0.04, MAT.glass));
  }
  return g;
}

function makeHotspot(object, title, text) {
  object.userData.hotspot = { title, text };
  return object;
}

function findHotspot(obj) {
  while (obj) {
    if (obj.userData && obj.userData.hotspot) return obj.userData.hotspot;
    obj = obj.parent;
  }
  return null;
}

