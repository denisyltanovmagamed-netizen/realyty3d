  const d = getDevelopment(id);
  if (!d) return;
  currentDevelopment = d;

  document.getElementById("dev-topbar-title").textContent = d.title;
  document.getElementById("dev-cover").src = d.coverImage;
  document.getElementById("dev-cover").onerror = function () { this.onerror = null; this.src = d.coverFallback; };
  document.getElementById("dev-title").textContent = d.title;
  document.getElementById("dev-city").textContent = d.city + (d.location ? " · " + d.location : "");

  document.getElementById("dev-facts").innerHTML = `
    <div class="dev-fact"><div class="dev-fact-label">Застройщик</div><div class="dev-fact-value">${d.developer}</div></div>
    <div class="dev-fact"><div class="dev-fact-label">Расположение</div><div class="dev-fact-value">${d.location}</div></div>
    <div class="dev-fact"><div class="dev-fact-label">Рассрочка</div><div class="dev-fact-value">${d.installmentMax}</div></div>
    <div class="dev-fact"><div class="dev-fact-label">Год сдачи</div><div class="dev-fact-value">${d.completionYear}</div></div>
    <div class="dev-fact"><div class="dev-fact-label">Комнатность</div><div class="dev-fact-value">до ${d.maxRooms}</div></div>
    <div class="dev-fact"><div class="dev-fact-label">Мат. капитал</div><div class="dev-fact-value">${d.maternityCapital ? "Да" : "Нет"}</div></div>
  `;

  renderPersonalBlock("dev-personal", `Здравствуйте! Интересуют квартиры в «${d.title}». Можно узнать подробнее?`);

  const objs = getObjectsFor(id).filter(o => o.status !== "sold");
  const objList = document.getElementById("dev-objects-list");
  if (!objs.length) {
    objList.innerHTML = '<div class="empty-note">Пока нет доступных квартир в этом ЖК.</div>';
  } else {
    objList.innerHTML = objs.map(o => `
      <a class="card" href="#object/${o.id}">
        <div class="card-img" style="background:${o.images[0]};"></div>
        <div class="card-body">
          <div class="card-type">${o.rooms}‑комнатная</div>
          <div class="card-title">${o.area}</div>
          <div class="card-price">${formatRub(o.price)}</div>
        </div>
      </a>
