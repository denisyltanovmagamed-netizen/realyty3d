   ========================================================= */
let currentObject = null;
let currentDevelopment = null;
let viewerInited = false;

function go(view, id) {
  document.querySelectorAll(".view").forEach(v => v.classList.remove("active"));
  document.getElementById("view-" + view).classList.add("active");
  document.getElementById("wa-bar").style.display = view === "object" ? "block" : "none";
  window.scrollTo(0, 0);

  if (view === "development" && id) renderDevelopment(id);
  if (view === "object" && id) renderObject(id);
  if (view === "catalog") renderDevelopments();

  const hashPart = view === "home" ? "" : view === "development" ? "development/" + id : view === "object" ? "object/" + id : view;
  location.hash = hashPart;
}

function handleHash() {
  const h = location.hash.replace("#", "");
  if (h.startsWith("object/")) go("object", h.split("/")[1]);
  else if (h.startsWith("development/")) go("development", h.split("/")[1]);
  else if (h === "catalog") go("catalog");
  else go("home");
}
window.addEventListener("hashchange", handleHash);

/* =========================================================
   КАТАЛОГ ЖК
   ========================================================= */
function renderDevelopments() {
  const list = document.getElementById("dev-list");
  if (!DEVELOPMENTS.length) {
    list.innerHTML = '<div class="empty-note">Пока нет ЖК в каталоге.</div>';
    return;
  }
  list.innerHTML = DEVELOPMENTS.map(d => {
    const objs = getObjectsFor(d.id).filter(o => o.status !== "sold");
    const minPrice = objs.length ? Math.min(...objs.map(o => o.price)) : null;
    return `
      <a class="card" href="#development/${d.id}">
        <img class="card-img" src="${d.coverImage}" onerror="this.onerror=null; this.src=d.coverFallback;" alt="${d.title}">
        <div class="card-body">
          <div class="card-type">${d.city}</div>
          <div class="card-title">${d.title}</div>
          <div class="card-meta"><span>${objs.length} ${objs.length === 1 ? "квартира" : "квартиры"} в продаже</span></div>
          <div class="card-price">${minPrice !== null ? "От " + formatRub(minPrice) : "Уточняйте цену"}</div>
        </div>
      </a>
    `;
  }).join("");
}

